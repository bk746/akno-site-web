# ——— Formulaire contact (overlay / layout) ———
# Crée une clé sur https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Boîte qui reçoit les messages des clients (ton email perso ou pro)
CONTACT_TO_EMAIL=hello@akno.fr

# Expéditeur @akno.fr — uniquement après domaine vérifié dans Resend :
# RESEND_DOMAIN_VERIFIED=true
# CONTACT_FROM_EMAIL=AKNO Contact <hello@akno.fr>
# Avant ça, l'API force onboarding@resend.dev automatiquement.

# Optionnel — indexation Google (sinon : prod Vercel = indexé, preview = non)
# NEXT_PUBLIC_ALLOW_INDEXING=true
